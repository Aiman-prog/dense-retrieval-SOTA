# Logs
*.log
# logs/ must EXIST for sbatch: SLURM opens --output=logs/<name>_%j.out before the
# job script runs, so an absent directory fails the job with no log to explain it.
logs/*
!logs/.gitkeep
wandb/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.lock

# Keep directory structure but ignore contents
!data/processed/.gitkeep
!data/models/.gitkeep
!data/indices/.gitkeep
!data/bright/.gitkeep

